# Postgres (read by src/infrastructure/postgres/client.ts and Debezium)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=tinderclone
POSTGRES_PASSWORD=tinderclone
POSTGRES_DB=tinderclone

# Debezium connector — defaults to the in-network postgres host/port,
# which is what registerConnector.ts hands to the Connect API.
DEBEZIUM_PG_HOST=postgres
DEBEZIUM_PG_PORT=5432
CONNECT_URL=http://localhost:8083

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tinderclone
NOTIFICATION_CONSUMER_GROUP=tinderclone-notifications

# Auth — override before shipping anywhere real
JWT_SECRET=change-me-in-production

# HTTP server
PORT=3000

# Logging
LOG_LEVEL=info
